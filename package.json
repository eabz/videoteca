{
  "name": "videoteca",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "check": "biome check .",
    "create-user": "bun ./scripts/create-user.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "deps": "bunx npm-check-updates -u",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "migrate": "bun ./scripts/migrate.ts",
    "smoke": "bun ./scripts/smoke.ts",
    "start": "next dev -p 3001 --webpack",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chakra-ui/react": "3.36.1",
    "@emotion/react": "11.14.0",
    "@tanstack/react-query": "5.102.3",
    "@tanstack/react-table": "9.1.2",
    "dotenv": "17.4.2",
    "match-sorter": "8.3.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.12.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3"
  }
}
